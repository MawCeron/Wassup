<component type="desktop-application">
  <id>io.github.MawCeron.Wassup</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Wassup</name>
  <summary>Unofficial WhatsApp client</summary>
  <description>
    <p>
      Wassup is a WhatsApp client for GNOME that speaks the protocol
      natively, without a web view, and stays light on memory. It links
      to your phone like WhatsApp Web, and a background service keeps
      notifications coming while its window is closed.
    </p>
    <ul>
      <li>Chats and groups, with photos, videos, documents, stickers, GIFs and voice notes</li>
      <li>Replies, reactions, mentions and link previews</li>
      <li>Search across chats and inside a chat</li>
      <li>Disappearing messages and chats locked behind your secret code</li>
      <li>History from your phone, loaded as you scroll</li>
    </ul>
    <p>
      Wassup is not affiliated with, endorsed by or connected to WhatsApp
      or Meta.
    </p>
  </description>
